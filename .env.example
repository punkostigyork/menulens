# Local development only. Change credentials before any deployment.
POSTGRES_USER=menulens
POSTGRES_PASSWORD=menulens_local
POSTGRES_DB=menulens
# Compose hostname; use localhost for a host-run backend.
DATABASE_URL=postgresql+psycopg://menulens:menulens_local@postgres:5432/menulens
CORS_ORIGINS=["http://localhost:3000"]
# Configure one backend AI provider (openai or anthropic) and a vision + structured-output model.
# Never put private AI or Places keys in frontend variables.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MENU_AI_PROVIDER=
MENU_AI_MODEL=
IMAGE_PROVIDER=
IMAGE_MODEL=
# Private server key: restrict to Places API (New).
PLACES_API_KEY=
# PUBLIC browser key: restrict to Maps JavaScript API and your website referrers.
# Use a separate key from PLACES_API_KEY. This key is intentionally browser-visible.
MAPS_API_KEY=
MAPS_MAP_ID=DEMO_MAP_ID
PLACES_TIMEOUT_SECONDS=15

# Maximum size of one uploaded file (10 MiB).
MAX_UPLOAD_BYTES=10485760
# Host-run backend only; Compose uses /app/uploads.
UPLOAD_DIR=uploads

# Phase 3 document preparation limits (no AI or OCR).
DOCUMENT_MAX_PAGES=20
DOCUMENT_IMAGE_EDGE=1600
DOCUMENT_MAX_IMAGE_PIXELS=40000000
DOCUMENT_MAX_TEXT_CHARS=200000
DOCUMENT_MAX_OUTPUT_BYTES=16777216

MENU_AI_TIMEOUT_SECONDS=60
MENU_AI_MAX_OUTPUT_TOKENS=12000

# Phase 7: IMAGE_PROVIDER=openai, IMAGE_MODEL=your compatible GPT Image model.
# Uses backend OPENAI_API_KEY independently of MENU_AI_PROVIDER.
IMAGE_TIMEOUT_SECONDS=180
IMAGE_MAX_BYTES=10485760

# Add the fictional Hungarian sample once at startup; never overwrites existing records.
SEED_DEMO=true
